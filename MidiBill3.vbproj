<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
	<Version>1.15.0</Version>
	<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>MidiBill3.My.MyApplication</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
	<ApplicationIcon>MidiBill3.ico</ApplicationIcon>
    <!-- VB fordítási szigorúság. Az Option Strict On megtiltja a csendes,
         szűkítő konverziókat és a késői kötést: a típushibák így fordítási
         időben derülnek ki, nem a felhasználó gépén (és a késői kötés
         futásidejű keresése sem terheli a MIDI-útvonalat). Az Option Infer
         SZÁNDÉKOSAN van kiírva, nem csak az alapértelmezettre hagyva: a kód
         több helyen támaszkodik a lambda-paraméterek típuskövetkeztetésére
         (pl. OrderBy(Function(k) k)), ami Infer=Off mellett Object-té, azaz
         Option Strict On mellett fordítási hibává válna. -->
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Midi" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>
  
  <ItemGroup>
    <!-- GYÁRI TARTALOM: csak a beépített General MIDI hangszer- és
         dobkészlet-lista kerül a program mappájába (a kimenet gyökerébe),
         és ezt szállítja majd a telepítő is. A program SOHA nem ír ide.
         Minden más - a felhasználó preset fájljai (.json) és a
         SoundFont-ból importált listái (.lst/.drm) - a felhasználói
         mappában (%AppData%\MidiBill3) lakik; lásd Modellek\Utvonalak.vb. -->
    <None Include="GM.lst">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="GM.drm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

<ItemGroup>
  <Content Include="MidiBill3.ico" />
</ItemGroup>

  <!--
    Miért kell ez a külön Target a fenti CopyToPublishDirectory mellé?
    Self-contained, single-file publish módnál (pl. "Folder" profil,
    win-x64 futtatókörnyezet-azonosítóval, "Produce single file"
    bekapcsolva) a .NET SDK az összes managed assembly-t (a program DLL-je,
    a NAudio DLL-ek, a runtimeconfig/deps.json) egyetlen .exe fájlba
    "olvasztja össze" - ezt a lépést a build a bin\...\<RID>\ köztes
    mappában készíti elő, a TÉNYLEGES publish-kimenet pedig a
    bin\...\publish\<RID>\ mappában landol, VÉGLEGESEN CSAK az összeolvasztott
    .exe-vel (+ .pdb-vel). A GM.lst/GM.drm nem "olvasztható bele" az exe-be
    (nem .NET assembly), és ilyenkor a fenti CopyToPublishDirectory
    metaadat ellenére sem kerülnek át automatikusan ebbe a végső publish
    mappába - ez egy ismert SDK-sajátosság single-file publish esetén.
    Az alábbi Target ezért a Publish célfeladat UTÁN, FELTÉTEL NÉLKÜL,
    közvetlenül a $(PublishDir)-be másolja mindkét fájlt - ez minden
    publish-módnál (sima Folder, self-contained, single-file, ClickOnce)
    egyaránt megbízhatóan működik, függetlenül attól, hogyan bánik az SDK
    éppen a "None"/CopyToPublishDirectory elemekkel.
  -->
  <Target Name="GyariAdatokMasolasaPublishUtan" AfterTargets="Publish">
    <ItemGroup>
      <GyariAdatFajlok Include="$(MSBuildProjectDirectory)\GM.lst;$(MSBuildProjectDirectory)\GM.drm" />
    </ItemGroup>
    <Copy SourceFiles="@(GyariAdatFajlok)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>